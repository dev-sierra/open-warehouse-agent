WAREHOUSE_BACKEND=snowflake

SNOWFLAKE_ACCOUNT=MYORG-MYACCOUNT
SNOWFLAKE_USER=OWA_APP_USER
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/owa_app_user_key.p8
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=OWA_DEMO
SNOWFLAKE_ROLE=OWA_APP_ROLE

DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_CATALOG=owa_demo
DATABRICKS_SCHEMA=default

# App runtime auth (service principal, OAuth client-credentials -- no PAT)
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# One-time bootstrap admin PAT (not used by the running app)
DATABRICKS_ADMIN_TOKEN=
