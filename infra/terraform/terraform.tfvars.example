# Copy this file to terraform.tfvars (already gitignored) and fill in the
# values marked REQUIRED below.

aws_region            = "us-west-1"
gpu_instance_type      = "g4dn.xlarge"
gateway_instance_type  = "t4g.nano"

# REQUIRED: set this to your own IP in CIDR form, e.g. "203.0.113.4/32"
# (find yours with `curl -s ifconfig.me`). The gateway's app port is never
# left open to 0.0.0.0/0 by default.
gateway_ingress_cidr = "REPLACE_ME/32"

alert_email        = "lukeodair398@gmail.com"
monthly_budget_usd = 20

# Leave as null until the Packer bake (infra/ami/) produces a real image;
# then set this to that image's AMI ID.
gpu_ami_id = null
